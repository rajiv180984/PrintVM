	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>1.8</java.version>
		<io-rest-assured.version>4.0.0</io-rest-assured.version>
		<!-- Aligns every embedded Tomcat module; TLS 1.3 needs Tomcat 9.0.13+ on a Java 11+ runtime -->
		<tomcat.version>9.0.64</tomcat.version>
		<!-- Groovy 2.5.3 (Boot 2.1.0 default) fails on JDK 16+ with NoClassDefFoundError: vmplugin.v7.Java7 -->
		<groovy.version>2.5.23</groovy.version>
		<!-- Log4j 2.11.1 (Boot 2.1.0 default) is vulnerable to Log4Shell; 2.17.2 is the last line supporting Java 8 -->
		<log4j2.version>2.17.2</log4j2.version>
	</properties>

	<repositories>
		<repository>
			<id>spring-snapshots</id>
